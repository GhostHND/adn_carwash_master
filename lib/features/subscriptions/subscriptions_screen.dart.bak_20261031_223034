class SubscriptionFormDialog extends StatefulWidget {
  const SubscriptionFormDialog({super.key});

  @override
  State<SubscriptionFormDialog> createState() => _SubscriptionFormDialogState();
}

class _SubscriptionFormDialogState extends State<SubscriptionFormDialog> {
  final _formKey = GlobalKey<FormState>();

  final _startController = TextEditingController();

  String _plan = 'B\u00e1sico';
  String _cycle = 'Mensual';

  @override
  void dispose() {
    _startController.dispose();
    super.dispose();
  }

  // ==========================================================
  // SELECCION DE FECHA
  // ==========================================================

  Future<void> _selectStartDate() async {
    final today = DateTime.now();

    final selected = await showDatePicker(
      context: context,
      initialDate: today,
      firstDate: DateTime(2020),
      lastDate: DateTime(2100),
    );

    if (!mounted || selected == null) {
      return;
    }

    final year = selected.year.toString();

    final month = selected.month.toString().padLeft(2, '0');

    final day = selected.day.toString().padLeft(2, '0');

    setState(() {
      _startController.text = '$year-$month-$day';
    });
  }

  // ==========================================================
  // ESTILOS
  // ==========================================================

  InputDecoration _decoration({required IconData icon, String? hint}) {
    OutlineInputBorder border(Color color) {
      return OutlineInputBorder(
        borderRadius: BorderRadius.circular(12),
        borderSide: BorderSide(color: color),
      );
    }

    return InputDecoration(
      hintText: hint,
      hintStyle: const TextStyle(color: AdnColors.muted, fontSize: 12),
      prefixIcon: Icon(icon, color: AdnColors.muted, size: 20),
      filled: true,
      fillColor: AdnColors.background,
      contentPadding: const EdgeInsets.symmetric(horizontal: 14, vertical: 16),
      enabledBorder: border(AdnColors.border),
      focusedBorder: border(AdnColors.turquoise),
      errorBorder: border(AdnColors.coral),
      focusedErrorBorder: border(AdnColors.coral),
    );
  }

  Widget _label(String text) {
    return Padding(
      padding: const EdgeInsets.only(bottom: 9),
      child: Text(
        text,
        style: const TextStyle(
          color: AdnColors.white,
          fontSize: 12,
          fontWeight: FontWeight.w800,
        ),
      ),
    );
  }

  // ==========================================================
  // CAMPO DE EMPRESA
  // ==========================================================

  Widget _companyField() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _label('Empresa'),

        Container(
          width: double.infinity,
          padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 17),
          decoration: BoxDecoration(
            color: AdnColors.background,
            borderRadius: BorderRadius.circular(12),
            border: Border.all(color: AdnColors.border),
          ),
          child: const Row(
            children: [
              Icon(Icons.business_outlined, color: AdnColors.muted, size: 20),
              SizedBox(width: 12),
              Expanded(
                child: Text(
                  'Sin empresas registradas',
                  style: TextStyle(color: AdnColors.muted, fontSize: 12),
                ),
              ),
              Icon(
                Icons.lock_outline_rounded,
                color: AdnColors.muted,
                size: 18,
              ),
            ],
          ),
        ),
      ],
    );
  }

  // ==========================================================
  // SELECCION DE PLAN
  // ==========================================================

  Widget _planField() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _label('Plan de suscripci\u00f3n'),

        DropdownButtonFormField<String>(
          key: const Key('subscription_plan'),
          initialValue: _plan,
          dropdownColor: AdnColors.panel,
          style: const TextStyle(color: AdnColors.white, fontSize: 13),
          decoration: _decoration(icon: Icons.workspace_premium_rounded),
          items: const [
            DropdownMenuItem(value: 'B\u00e1sico', child: Text('B\u00e1sico')),
            DropdownMenuItem(value: 'Intermedio', child: Text('Intermedio')),
            DropdownMenuItem(value: 'Pro', child: Text('Pro')),
          ],
          onChanged: (value) {
            if (value != null) {
              setState(() {
                _plan = value;
              });
            }
          },
        ),
      ],
    );
  }

  // ==========================================================
  // PERIODO DE FACTURACION
  // ==========================================================

  Widget _billingField() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _label('Per\u00edodo de facturaci\u00f3n'),

        DropdownButtonFormField<String>(
          key: const Key('subscription_cycle'),
          initialValue: _cycle,
          dropdownColor: AdnColors.panel,
          style: const TextStyle(color: AdnColors.white, fontSize: 13),
          decoration: _decoration(icon: Icons.event_repeat_rounded),
          items: const [
            DropdownMenuItem(value: 'Mensual', child: Text('Mensual')),
            DropdownMenuItem(value: 'Trimestral', child: Text('Trimestral')),
            DropdownMenuItem(value: 'Anual', child: Text('Anual')),
          ],
          onChanged: (value) {
            if (value != null) {
              setState(() {
                _cycle = value;
              });
            }
          },
        ),
      ],
    );
  }

  // ==========================================================
  // FECHA DE INICIO
  // ==========================================================

  Widget _startField() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _label('Fecha de inicio'),

        TextFormField(
          key: const Key('subscription_start'),
          controller: _startController,
          readOnly: true,
          onTap: _selectStartDate,
          validator: (value) {
            if (value == null || value.isEmpty) {
              return 'Selecciona una fecha de inicio.';
            }

            return null;
          },
          style: const TextStyle(color: AdnColors.white, fontSize: 13),
          decoration: _decoration(
            icon: Icons.calendar_today_rounded,
            hint: 'Seleccionar fecha',
          ),
        ),
      ],
    );
  }

  // ==========================================================
  // VALIDACION LOCAL
  // ==========================================================

  void _validate() {
    FocusScope.of(context).unfocus();

    if (_formKey.currentState?.validate() != true) {
      return;
    }

    // No hay persistencia.
    // No se registra ninguna suscripcion.

    Navigator.of(context).pop(true);
  }

  // ==========================================================
  // INTERFAZ DEL FORMULARIO
  // ==========================================================

  @override
  Widget build(BuildContext context) {
    final mobile = MediaQuery.sizeOf(context).width < 620;

    return Dialog(
      backgroundColor: AdnColors.panel,
      insetPadding: EdgeInsets.symmetric(
        horizontal: mobile ? 12 : 24,
        vertical: 18,
      ),
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(20),
        side: const BorderSide(color: AdnColors.border),
      ),
      child: SizedBox(
        width: 610,
        child: SingleChildScrollView(
          padding: EdgeInsets.all(mobile ? 17 : 24),
          child: Form(
            key: _formKey,
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  children: [
                    const Icon(
                      Icons.add_card_rounded,
                      color: AdnColors.turquoiseLight,
                      size: 30,
                    ),

                    const SizedBox(width: 12),

                    const Expanded(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Text(
                            'Nueva suscripci\u00f3n',
                            style: TextStyle(
                              color: AdnColors.white,
                              fontSize: 19,
                              fontWeight: FontWeight.w800,
                            ),
                          ),

                          SizedBox(height: 5),

                          Text(
                            'Configuraci\u00f3n preliminar',
                            style: TextStyle(
                              color: AdnColors.muted,
                              fontSize: 12,
                            ),
                          ),
                        ],
                      ),
                    ),

                    IconButton(
                      tooltip: 'Cerrar',
                      onPressed: () {
                        Navigator.of(context).pop();
                      },
                      icon: const Icon(
                        Icons.close_rounded,
                        color: AdnColors.muted,
                      ),
                    ),
                  ],
                ),

                const SizedBox(height: 18),

                const Divider(height: 1, color: AdnColors.border),

                const SizedBox(height: 20),

                _companyField(),

                const SizedBox(height: 17),

                _planField(),

                const SizedBox(height: 17),

                _billingField(),

                const SizedBox(height: 17),

                _startField(),

                const SizedBox(height: 20),

                Container(
                  width: double.infinity,
                  padding: const EdgeInsets.all(15),
                  decoration: BoxDecoration(
                    color: AdnColors.turquoise.withValues(alpha: 0.06),
                    borderRadius: BorderRadius.circular(12),
                    border: Border.all(
                      color: AdnColors.turquoise.withValues(alpha: 0.18),
                    ),
                  ),
                  child: const Text(
                    'Los per\u00edodos son opciones preliminares. '
                    'El precio, vencimiento, plazo de gracia '
                    'y reglas de renovaci\u00f3n se '
                    'configurar\u00e1n posteriormente. '
                    'Esta pantalla no guarda informaci\u00f3n.',
                    style: TextStyle(
                      color: AdnColors.white,
                      fontSize: 12,
                      height: 1.6,
                    ),
                  ),
                ),

                const SizedBox(height: 19),

                Row(
                  children: [
                    Expanded(
                      child: OutlinedButton(
                        onPressed: () {
                          Navigator.of(context).pop();
                        },
                        style: OutlinedButton.styleFrom(
                          foregroundColor: AdnColors.white,
                          side: const BorderSide(color: AdnColors.border),
                          padding: const EdgeInsets.symmetric(vertical: 16),
                        ),
                        child: const Text('Cancelar'),
                      ),
                    ),

                    const SizedBox(width: 12),

                    Expanded(
                      child: FilledButton(
                        onPressed: _validate,
                        style: FilledButton.styleFrom(
                          backgroundColor: AdnColors.turquoise,
                          foregroundColor: Colors.white,
                          padding: const EdgeInsets.symmetric(vertical: 16),
                        ),
                        child: const Text(
                          'Revisar datos',
                          style: TextStyle(fontWeight: FontWeight.w800),
                        ),
                      ),
                    ),
                  ],
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}
