class SubscriptionsScreen extends StatelessWidget {
  const SubscriptionsScreen({super.key});

  Future<void> _openForm(BuildContext context) async {
    final reviewed = await showDialog<bool>(
      context: context,
      builder: (_) => const SubscriptionFormDialog(),
    );

    if (!context.mounted || reviewed != true) {
      return;
    }

    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text(
          'Datos revisados correctamente. '
          'No se ha creado ninguna suscripci\u00f3n '
          'porque todav\u00eda no existe una empresa '
          'vinculada ni una conexi\u00f3n con el servidor.',
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (context, constraints) {
        final mobile = constraints.maxWidth < 620;
        final padding = mobile ? 18.0 : 29.0;

        final availableWidth = constraints.maxWidth - padding * 2;

        final columns = availableWidth >= 1080
            ? 4
            : availableWidth >= 580
            ? 2
            : 1;

        final cardWidth = (availableWidth - 14 * (columns - 1)) / columns;

        return SingleChildScrollView(
          padding: EdgeInsets.all(padding),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              if (mobile)
                Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    const _SubscriptionsHeading(),
                    const SizedBox(height: 19),
                    SizedBox(
                      width: double.infinity,
                      child: _NewSubscriptionButton(
                        onPressed: () => _openForm(context),
                      ),
                    ),
                  ],
                )
              else
                Row(
                  children: [
                    const Expanded(child: _SubscriptionsHeading()),
                    const SizedBox(width: 16),
                    _NewSubscriptionButton(onPressed: () => _openForm(context)),
                  ],
                ),

              const SizedBox(height: 25),

              Wrap(
                spacing: 14,
                runSpacing: 14,
                children: [
                  _StatusCard(
                    width: cardWidth,
                    title: 'Suscripciones vigentes',
                    icon: Icons.verified_rounded,
                    accent: const Color(0xFF22C55E),
                  ),
                  _StatusCard(
                    width: cardWidth,
                    title: 'Pr\u00f3ximas a vencer',
                    icon: Icons.schedule_rounded,
                    accent: const Color(0xFFF5C000),
                  ),
                  _StatusCard(
                    width: cardWidth,
                    title: 'Suscripciones vencidas',
                    icon: Icons.event_busy_rounded,
                    accent: AdnColors.coral,
                  ),
                  _StatusCard(
                    width: cardWidth,
                    title: 'Suscripciones suspendidas',
                    icon: Icons.pause_circle_rounded,
                    accent: AdnColors.muted,
                  ),
                ],
              ),

              const SizedBox(height: 23),

              const _DevelopmentNotice(),

              const SizedBox(height: 23),

              const _SubscriptionDirectory(),

              const SizedBox(height: 23),

              const _SubscriptionRules(),
            ],
          ),
        );
      },
    );
  }
}

