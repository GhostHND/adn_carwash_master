class CompaniesScreen extends StatelessWidget {
  const CompaniesScreen({super.key});

  void _openCompanyForm(BuildContext context) {
    showDialog<void>(
      context: context,
      builder: (_) {
        return CompanyFormDialog(
          onValidated: () {
            Navigator.of(context, rootNavigator: true).pop();

            ScaffoldMessenger.of(context).showSnackBar(
              SnackBar(
                backgroundColor: AdnColors.panel,
                behavior: SnackBarBehavior.floating,
                content: const Text(
                  'Formulario validado correctamente. '
                  'La empresa todavÃ­a no se ha registrado. '
                  'El guardado estarÃ¡ disponible cuando '
                  'conectemos la API.',
                ),
              ),
            );
          },
        );
      },
    );
  }

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (context, constraints) {
        final bool isMobile = constraints.maxWidth < 620;

        final double padding = isMobile ? 18 : 29;

        final double contentWidth = constraints.maxWidth - (padding * 2);

        final int columns = contentWidth >= 900
            ? 3
            : contentWidth >= 520
            ? 2
            : 1;

        final double cardWidth = (contentWidth - 16 * (columns - 1)) / columns;

        return SingleChildScrollView(
          padding: EdgeInsets.all(padding),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              // ==========================================
              // ENCABEZADO
              // ==========================================

              if (isMobile)
                Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    const _PageHeading(),
                    const SizedBox(height: 20),
                    _NewCompanyButton(
                      onPressed: () => _openCompanyForm(context),
                    ),
                  ],
                )
              else
                Row(
                  crossAxisAlignment: CrossAxisAlignment.center,
                  children: [
                    const Expanded(child: _PageHeading()),
                    const SizedBox(width: 16),
                    _NewCompanyButton(
                      onPressed: () => _openCompanyForm(context),
                    ),
                  ],
                ),

              const SizedBox(height: 27),

              // ==========================================
              // INDICADORES GENERALES
              // ==========================================
              Wrap(
                spacing: 16,
                runSpacing: 16,
                children: [
                  _CompanyMetricCard(
                    width: cardWidth,
                    title: 'Empresas registradas',
                    icon: Icons.business_rounded,
                    accent: AdnColors.turquoise,
                  ),
                  _CompanyMetricCard(
                    width: cardWidth,
                    title: 'Empresas activas',
                    icon: Icons.check_circle_rounded,
                    accent: const Color(0xFF22C55E),
                  ),
                  _CompanyMetricCard(
                    width: cardWidth,
                    title: 'Empresas suspendidas',
                    icon: Icons.pause_circle_rounded,
                    accent: AdnColors.coral,
                  ),
                ],
              ),

              const SizedBox(height: 25),

              // ==========================================
              // ESTADO DE CONEXIÃ“N
              // ==========================================
              Container(
                width: double.infinity,
                padding: const EdgeInsets.all(16),
                decoration: BoxDecoration(
                  color: AdnColors.turquoise.withValues(alpha: 0.06),
                  borderRadius: BorderRadius.circular(14),
                  border: Border.all(
                    color: AdnColors.turquoise.withValues(alpha: 0.18),
                  ),
                ),
                child: const Row(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Icon(
                      Icons.info_outline_rounded,
                      color: AdnColors.turquoiseLight,
                      size: 21,
                    ),
                    SizedBox(width: 12),
                    Expanded(
                      child: Text(
                        'MÃ³dulo en desarrollo. '
                        'El formulario permite validar los datos '
                        'de una empresa, pero todavÃ­a no se conecta '
                        'con la base de datos central.',
                        style: TextStyle(
                          color: AdnColors.white,
                          fontSize: 12,
                          height: 1.6,
                        ),
                      ),
                    ),
                  ],
                ),
              ),

              const SizedBox(height: 24),

              // ==========================================
              // LISTADO DE EMPRESAS
              // ==========================================
              Container(
                width: double.infinity,
                constraints: const BoxConstraints(minHeight: 340),
                decoration: BoxDecoration(
                  color: AdnColors.panel,
                  borderRadius: BorderRadius.circular(19),
                  border: Border.all(color: AdnColors.border),
                ),
                child: Column(
                  children: [
                    const Padding(
                      padding: EdgeInsets.all(22),
                      child: Row(
                        children: [
                          Expanded(
                            child: Text(
                              'Directorio de empresas',
                              style: TextStyle(
                                color: AdnColors.white,
                                fontSize: 17,
                                fontWeight: FontWeight.w800,
                              ),
                            ),
                          ),
                          Icon(
                            Icons.business_center_outlined,
                            color: AdnColors.muted,
                            size: 21,
                          ),
                        ],
                      ),
                    ),

                    const Divider(height: 1, color: AdnColors.border),

                    Padding(
                      padding: const EdgeInsets.symmetric(
                        horizontal: 20,
                        vertical: 52,
                      ),
                      child: Column(
                        children: [
                          Container(
                            width: 74,
                            height: 74,
                            decoration: BoxDecoration(
                              color: AdnColors.turquoise.withValues(
                                alpha: 0.08,
                              ),
                              borderRadius: BorderRadius.circular(19),
                            ),
                            child: const Icon(
                              Icons.domain_add_rounded,
                              color: AdnColors.turquoise,
                              size: 34,
                            ),
                          ),

                          const SizedBox(height: 19),

                          const Text(
                            'AÃºn no hay empresas para mostrar',
                            textAlign: TextAlign.center,
                            style: TextStyle(
                              color: AdnColors.white,
                              fontSize: 17,
                              fontWeight: FontWeight.w800,
                            ),
                          ),

                          const SizedBox(height: 11),

                          ConstrainedBox(
                            constraints: BoxConstraints(maxWidth: 430),
                            child: Text(
                              'Cuando conectemos CarWash Master '
                              'con su servidor, aquÃ­ aparecerÃ¡n '
                              'los autolavados registrados, '
                              'sus planes y sus estados.',
                              textAlign: TextAlign.center,
                              style: TextStyle(
                                color: AdnColors.muted,
                                fontSize: 12,
                                height: 1.7,
                              ),
                            ),
                          ),
                        ],
                      ),
                    ),
                  ],
                ),
              ),
            ],
          ),
        );
      },
    );
  }
}

