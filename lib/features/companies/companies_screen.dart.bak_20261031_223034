class CompanyFormDialog extends StatefulWidget {
  final VoidCallback onValidated;

  const CompanyFormDialog({super.key, required this.onValidated});

  @override
  State<CompanyFormDialog> createState() => _CompanyFormDialogState();
}

class _CompanyFormDialogState extends State<CompanyFormDialog> {
  final GlobalKey<FormState> _formKey = GlobalKey<FormState>();

  final _businessName = TextEditingController();
  final _legalName = TextEditingController();
  final _phone = TextEditingController();
  final _businessEmail = TextEditingController();

  final _country = TextEditingController(text: 'Honduras');

  final _city = TextEditingController();
  final _adminName = TextEditingController();
  final _adminEmail = TextEditingController();

  String _selectedPlan = 'B\u00e1sico';

  @override
  void dispose() {
    _businessName.dispose();
    _legalName.dispose();
    _phone.dispose();
    _businessEmail.dispose();
    _country.dispose();
    _city.dispose();
    _adminName.dispose();
    _adminEmail.dispose();

    super.dispose();
  }

  // ==========================================================
  // VALIDACIONES
  // ==========================================================

  String? _requiredValidator(String? value) {
    if (value == null || value.trim().isEmpty) {
      return 'Este campo es obligatorio.';
    }

    return null;
  }

  String? _emailValidator(String? value) {
    final text = value?.trim() ?? '';

    if (text.isEmpty) {
      return 'El correo es obligatorio.';
    }

    final valid = RegExp(r'^[^\s@]+@[^\s@]+\.[^\s@]+$').hasMatch(text);

    if (!valid) {
      return 'Ingresa un correo electr\u00f3nico v\u00e1lido.';
    }

    return null;
  }

  String? _optionalEmailValidator(String? value) {
    final text = value?.trim() ?? '';

    if (text.isEmpty) {
      return null;
    }

    final valid = RegExp(r'^[^\s@]+@[^\s@]+\.[^\s@]+$').hasMatch(text);

    return valid ? null : 'Ingresa un correo electr\u00f3nico v\u00e1lido.';
  }

  String? _phoneValidator(String? value) {
    final text = value?.trim() ?? '';

    if (text.isEmpty) {
      return 'El tel\u00e9fono es obligatorio.';
    }

    final digits = text.replaceAll(RegExp(r'\D'), '');

    if (digits.length < 8 || digits.length > 15) {
      return 'Ingresa un tel\u00e9fono v\u00e1lido.';
    }

    return null;
  }

  // ==========================================================
  // ESTILOS DE CAMPOS
  // ==========================================================

  InputDecoration _decoration({required String hint, required IconData icon}) {
    return InputDecoration(
      hintText: hint,
      hintStyle: const TextStyle(color: AdnColors.muted, fontSize: 12),
      prefixIcon: Icon(icon, size: 20, color: AdnColors.muted),
      filled: true,
      fillColor: AdnColors.background,
      contentPadding: const EdgeInsets.symmetric(horizontal: 15, vertical: 17),
      enabledBorder: OutlineInputBorder(
        borderRadius: BorderRadius.circular(12),
        borderSide: const BorderSide(color: AdnColors.border),
      ),
      focusedBorder: OutlineInputBorder(
        borderRadius: BorderRadius.circular(12),
        borderSide: const BorderSide(color: AdnColors.turquoise, width: 1.4),
      ),
      errorBorder: OutlineInputBorder(
        borderRadius: BorderRadius.circular(12),
        borderSide: const BorderSide(color: AdnColors.coral),
      ),
      focusedErrorBorder: OutlineInputBorder(
        borderRadius: BorderRadius.circular(12),
        borderSide: const BorderSide(color: AdnColors.coral, width: 1.4),
      ),
    );
  }

  Widget _fieldLabel(String label, {bool required = false}) {
    return Padding(
      padding: const EdgeInsets.only(bottom: 9),
      child: Row(
        children: [
          Flexible(
            child: Text(
              label,
              style: const TextStyle(
                color: AdnColors.white,
                fontSize: 12,
                fontWeight: FontWeight.w700,
              ),
            ),
          ),

          if (required) ...[
            const SizedBox(width: 4),
            const Text(
              '*',
              style: TextStyle(
                color: AdnColors.coral,
                fontSize: 13,
                fontWeight: FontWeight.w800,
              ),
            ),
          ],
        ],
      ),
    );
  }

  Widget _input({
    required TextEditingController controller,
    required String label,
    required String hint,
    required IconData icon,
    bool required = false,
    String? Function(String?)? validator,
    TextInputType keyboardType = TextInputType.text,
  }) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _fieldLabel(label, required: required),

        TextFormField(
          controller: controller,
          keyboardType: keyboardType,
          textInputAction: TextInputAction.next,
          autocorrect: false,
          style: const TextStyle(color: AdnColors.white, fontSize: 13),
          decoration: _decoration(hint: hint, icon: icon),
          validator: validator,
          autovalidateMode: AutovalidateMode.onUserInteraction,
        ),
      ],
    );
  }

  Widget _fieldRow({
    required Widget first,
    required Widget second,
    required bool twoColumns,
  }) {
    if (twoColumns) {
      return Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Expanded(child: first),
          const SizedBox(width: 16),
          Expanded(child: second),
        ],
      );
    }

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [first, const SizedBox(height: 17), second],
    );
  }

  Widget _sectionTitle(String title) {
    return Padding(
      padding: const EdgeInsets.only(top: 8, bottom: 18),
      child: Text(
        title,
        style: const TextStyle(
          color: AdnColors.white,
          fontSize: 17,
          fontWeight: FontWeight.w800,
        ),
      ),
    );
  }

  // ==========================================================
  // SELECTOR DE PLAN
  // ==========================================================

  Widget _planSelector() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _fieldLabel('Plan inicial', required: true),

        DropdownButtonFormField<String>(
          initialValue: _selectedPlan,
          dropdownColor: AdnColors.panel,
          style: const TextStyle(color: AdnColors.white, fontSize: 13),
          decoration: _decoration(
            hint: 'Selecciona un plan',
            icon: Icons.workspace_premium_rounded,
          ),
          items: const [
            DropdownMenuItem(value: 'B\u00e1sico', child: Text('B\u00e1sico')),
            DropdownMenuItem(value: 'Intermedio', child: Text('Intermedio')),
            DropdownMenuItem(value: 'Pro', child: Text('Pro')),
          ],
          onChanged: (value) {
            if (value != null) {
              setState(() {
                _selectedPlan = value;
              });
            }
          },
        ),
      ],
    );
  }

  // ==========================================================
  // VALIDACION LOCAL
  // ==========================================================

  void _validateForm() {
    FocusScope.of(context).unfocus();

    if (_formKey.currentState?.validate() != true) {
      return;
    }

    // Todavia no hay una API conectada.
