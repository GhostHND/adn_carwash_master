// ============================================================
// FORMULARIO PRELIMINAR DE PAGO
// ============================================================

class PaymentFormDialog extends StatefulWidget {
  const PaymentFormDialog({super.key});

  @override
  State<PaymentFormDialog> createState() => _PaymentFormDialogState();
}

class _PaymentFormDialogState extends State<PaymentFormDialog> {
  final _formKey = GlobalKey<FormState>();

  final _totalController = TextEditingController();
  final _paidController = TextEditingController();
  final _referenceController = TextEditingController();

  String _method = 'Transferencia';
  DateTime _paymentDate = DateTime.now();

  @override
  void dispose() {
    _totalController.dispose();
    _paidController.dispose();
    _referenceController.dispose();
    super.dispose();
  }

  // ==========================================================
  // CONVERSION DE IMPORTES A CENTAVOS
  // ==========================================================

  int? _toCents(String text) {
    final normalized = text.trim().replaceAll(',', '.');

    if (!RegExp(r'^\d+(?:\.\d{1,2})?$').hasMatch(normalized)) {
      return null;
    }

    final parts = normalized.split('.');
    final units = int.tryParse(parts[0]);

    if (units == null || units > 999999999) {
      return null;
    }

    final cents = parts.length == 2 ? int.parse(parts[1].padRight(2, '0')) : 0;

    return units * 100 + cents;
  }

  String _formatMoney(int cents) {
    return 'L ${(cents / 100).toStringAsFixed(2)}';
  }

  String? _validateTotal(String? value) {
    final amount = _toCents(value ?? '');

    if (amount == null || amount <= 0) {
      return 'Ingresa un importe mayor que cero '
          'con hasta dos decimales.';
    }

    return null;
  }

  String? _validatePaid(String? value) {
    final paid = _toCents(value ?? '');
    final total = _toCents(_totalController.text);

    if (paid == null || paid <= 0) {
      return 'Ingresa un abono mayor que cero '
          'con hasta dos decimales.';
    }

    if (total != null && paid > total) {
      return 'El abono no puede superar el importe.';
    }

    return null;
  }

  // ==========================================================
  // FECHA DEL PAGO
  // ==========================================================

  String get _formattedDate {
    final year = _paymentDate.year;
    final month = _paymentDate.month.toString().padLeft(2, '0');
    final day = _paymentDate.day.toString().padLeft(2, '0');

    return '$year-$month-$day';
  }

  Future<void> _selectDate() async {
    final selected = await showDatePicker(
      context: context,
      initialDate: _paymentDate,
      firstDate: DateTime(2020),
      lastDate: DateTime(2100),
    );

    if (!mounted || selected == null) {
      return;
    }

    setState(() {
      _paymentDate = selected;
    });
  }

  // ==========================================================
  // ESTILOS DE FORMULARIO
  // ==========================================================

  InputDecoration _decoration({required IconData icon, required String hint}) {
    OutlineInputBorder border(Color color) {
      return OutlineInputBorder(
        borderRadius: BorderRadius.circular(12),
        borderSide: BorderSide(color: color),
      );
    }

    return InputDecoration(
      hintText: hint,
      hintStyle: const TextStyle(color: AdnColors.muted, fontSize: 12),
      prefixIcon: Icon(icon, color: AdnColors.muted, size: 20),
      filled: true,
      fillColor: AdnColors.background,
      contentPadding: const EdgeInsets.symmetric(horizontal: 14, vertical: 16),
      enabledBorder: border(AdnColors.border),
      focusedBorder: border(AdnColors.turquoise),
      errorBorder: border(AdnColors.coral),
      focusedErrorBorder: border(AdnColors.coral),
    );
  }

  Widget _label(String text) {
    return Padding(
      padding: const EdgeInsets.only(bottom: 9),
      child: Text(
        text,
        style: const TextStyle(
          color: AdnColors.white,
          fontSize: 12,
          fontWeight: FontWeight.w800,
        ),
      ),
    );
  }

  Widget _amountField({
    required Key key,
    required TextEditingController controller,
    required String label,
    required String hint,
    required String? Function(String?) validator,
  }) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _label(label),
        TextFormField(
          key: key,
          controller: controller,
          keyboardType: const TextInputType.numberWithOptions(decimal: true),
          textInputAction: TextInputAction.next,
          onChanged: (_) => setState(() {}),
          validator: validator,
          style: const TextStyle(color: AdnColors.white, fontSize: 13),
          decoration: _decoration(icon: Icons.attach_money_rounded, hint: hint),
        ),
      ],
    );
  }

  Widget _fieldPair({
    required Widget first,
    required Widget second,
    required bool twoColumns,
  }) {
    if (twoColumns) {
      return Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Expanded(child: first),
          const SizedBox(width: 16),
          Expanded(child: second),
        ],
      );
    }

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [first, const SizedBox(height: 18), second],
    );
  }

  // ==========================================================
  // SUSCRIPCION NO DISPONIBLE TODAVIA
  // ==========================================================

  Widget _subscriptionField() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _label('Suscripci\u00f3n asociada'),
        Container(
          width: double.infinity,
          padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 17),
          decoration: BoxDecoration(
            color: AdnColors.background,
            borderRadius: BorderRadius.circular(12),
            border: Border.all(color: AdnColors.border),
          ),
          child: const Row(
            children: [
              Icon(
                Icons.credit_card_off_rounded,
                color: AdnColors.muted,
                size: 20,
              ),
              SizedBox(width: 12),
              Expanded(
                child: Text(
                  'Sin suscripciones registradas',
                  style: TextStyle(color: AdnColors.muted, fontSize: 12),
                ),
              ),
              Icon(
                Icons.lock_outline_rounded,
                color: AdnColors.muted,
                size: 18,
              ),
            ],
          ),
        ),
      ],
    );
  }

  // ==========================================================
  // FORMA DE PAGO
  // ==========================================================

  Widget _methodField() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _label('Forma de pago'),
        DropdownButtonFormField<String>(
          key: const Key('payment_method'),
          initialValue: _method,
          dropdownColor: AdnColors.panel,
          style: const TextStyle(color: AdnColors.white, fontSize: 13),
          decoration: _decoration(
            icon: Icons.payments_outlined,
            hint: 'Seleccionar forma de pago',
          ),
          items: const [
            DropdownMenuItem(
              value: 'Transferencia',
              child: Text('Transferencia'),
            ),
            DropdownMenuItem(value: 'Efectivo', child: Text('Efectivo')),
            DropdownMenuItem(value: 'Tarjeta', child: Text('Tarjeta')),
            DropdownMenuItem(value: 'Otro', child: Text('Otro')),
          ],
          onChanged: (value) {
            if (value != null) {
              setState(() {
                _method = value;
              });
            }
          },
        ),
      ],
    );
  }

  // ==========================================================
  // FECHA Y REFERENCIA
  // ==========================================================

  Widget _dateField() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _label('Fecha del pago'),
        SizedBox(
          width: double.infinity,
          child: OutlinedButton.icon(
            key: const Key('payment_date'),
            onPressed: _selectDate,
            icon: const Icon(Icons.calendar_today_rounded, size: 18),
            label: Text(_formattedDate),
            style: OutlinedButton.styleFrom(
              alignment: Alignment.centerLeft,
              foregroundColor: AdnColors.white,
              side: const BorderSide(color: AdnColors.border),
              padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 18),
              shape: RoundedRectangleBorder(
                borderRadius: BorderRadius.circular(12),
              ),
            ),
          ),
        ),
      ],
    );
  }

  Widget _referenceField() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _label('Referencia o comprobante externo'),
        TextFormField(
          key: const Key('payment_reference'),
          controller: _referenceController,
          textInputAction: TextInputAction.done,
          style: const TextStyle(color: AdnColors.white, fontSize: 13),
          decoration: _decoration(icon: Icons.tag_rounded, hint: 'Opcional'),
        ),
      ],
    );
  }

  // ==========================================================
  // RESUMEN DE CALCULO LOCAL
  // ==========================================================

  Widget _summary() {
    final total = _toCents(_totalController.text);
    final paid = _toCents(_paidController.text);

    final valid =
        total != null && total > 0 && paid != null && paid > 0 && paid <= total;

    final balance = valid ? total - paid : null;

    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(17),
      decoration: BoxDecoration(
        color: AdnColors.turquoise.withValues(alpha: 0.06),
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: AdnColors.turquoise.withValues(alpha: 0.20)),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const Text(
            'Resumen del borrador',
            style: TextStyle(
              color: AdnColors.white,
              fontSize: 13,
              fontWeight: FontWeight.w800,
            ),
          ),
          const SizedBox(height: 11),

          if (balance == null)
            const Text(
              'Ingresa un importe y un abono v\u00e1lidos '
              'para calcular el saldo.',
              style: TextStyle(
                color: AdnColors.muted,
                fontSize: 12,
                height: 1.6,
              ),
            )
          else ...[
            Text(
              'Importe: ${_formatMoney(total)}',
              style: const TextStyle(color: AdnColors.white, fontSize: 12),
            ),
            const SizedBox(height: 7),
            Text(
              'Abono: ${_formatMoney(paid)}',
              style: const TextStyle(color: AdnColors.white, fontSize: 12),
            ),
            const SizedBox(height: 10),
            Text(
              'Saldo estimado: ${_formatMoney(balance)}',
              key: const Key('payment_balance'),
              style: const TextStyle(
                color: AdnColors.turquoiseLight,
                fontSize: 15,
                fontWeight: FontWeight.w900,
              ),
            ),
          ],

          const SizedBox(height: 12),

          const Text(
            'Este c\u00e1lculo es una vista previa. '
            'No representa un saldo contable real.',
            style: TextStyle(color: AdnColors.muted, fontSize: 11, height: 1.5),
          ),
        ],
      ),
    );
  }

  // ==========================================================
  // VALIDAR SIN GUARDAR
  // ==========================================================

  void _validateDraft() {
    FocusScope.of(context).unfocus();

    if (_formKey.currentState?.validate() != true) {
      return;
    }

    // No hay API, empresa ni suscripcion vinculada.
    // No se almacena ni emite comprobante alguno.

    Navigator.of(context).pop(true);
  }

  // ==========================================================
  // DIALOGO RESPONSIVE
  // ==========================================================

  @override
  Widget build(BuildContext context) {
    final size = MediaQuery.sizeOf(context);
    final keyboard = MediaQuery.viewInsetsOf(context).bottom;
    final mobile = size.width < 620;

    final height = math.min(
      780.0,
      math.max(280.0, size.height - keyboard - 36),
    );

    return Dialog(
      backgroundColor: AdnColors.panel,
      insetPadding: EdgeInsets.symmetric(
        horizontal: mobile ? 12 : 24,
        vertical: 18,
      ),
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(20),
        side: const BorderSide(color: AdnColors.border),
      ),
      child: SizedBox(
        width: 740,
        height: height,
        child: Padding(
          padding: EdgeInsets.all(mobile ? 16 : 24),
          child: Column(
            children: [
              Row(
                children: [
                  const Icon(
                    Icons.add_card_rounded,
                    color: AdnColors.turquoiseLight,
                    size: 30,
                  ),
                  const SizedBox(width: 12),
                  const Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Text(
                          'Nuevo pago',
                          style: TextStyle(
                            color: AdnColors.white,
                            fontSize: 19,
                            fontWeight: FontWeight.w800,
                          ),
                        ),
                        SizedBox(height: 5),
                        Text(
                          'Revisi\u00f3n de cobro o abono',
                          style: TextStyle(
                            color: AdnColors.muted,
                            fontSize: 12,
                          ),
                        ),
                      ],
                    ),
                  ),
                  IconButton(
                    tooltip: 'Cerrar',
                    onPressed: () => Navigator.of(context).pop(),
                    icon: const Icon(
                      Icons.close_rounded,
                      color: AdnColors.muted,
                    ),
                  ),
                ],
              ),

              const SizedBox(height: 17),

              const Divider(height: 1, color: AdnColors.border),

              Expanded(
                child: Form(
                  key: _formKey,
                  child: LayoutBuilder(
                    builder: (context, constraints) {
                      final twoColumns = constraints.maxWidth >= 610;

                      return SingleChildScrollView(
                        padding: const EdgeInsets.symmetric(vertical: 19),
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            const Text(
                              'Datos del cobro',
                              style: TextStyle(
                                color: AdnColors.white,
                                fontSize: 17,
                                fontWeight: FontWeight.w800,
                              ),
                            ),

                            const SizedBox(height: 18),

                            _subscriptionField(),

                            const SizedBox(height: 18),

                            _fieldPair(
                              twoColumns: twoColumns,
                              first: _amountField(
                                key: const Key('payment_total'),
                                controller: _totalController,
                                label: 'Importe de referencia (L)',
                                hint: 'Ej. 1000.00',
                                validator: _validateTotal,
                              ),
                              second: _amountField(
                                key: const Key('payment_paid'),
                                controller: _paidController,
                                label: 'Abono (L)',
                                hint: 'Ej. 500.00',
                                validator: _validatePaid,
                              ),
                            ),

                            const SizedBox(height: 18),

                            _fieldPair(
                              twoColumns: twoColumns,
                              first: _methodField(),
                              second: _dateField(),
                            ),

                            const SizedBox(height: 18),

                            _referenceField(),

                            const SizedBox(height: 22),

                            _summary(),
                          ],
                        ),
                      );
                    },
                  ),
                ),
              ),

              const Divider(height: 1, color: AdnColors.border),

              const SizedBox(height: 15),

              Row(
                children: [
                  Expanded(
                    child: OutlinedButton(
                      onPressed: () => Navigator.of(context).pop(),
                      style: OutlinedButton.styleFrom(
                        foregroundColor: AdnColors.white,
                        padding: const EdgeInsets.symmetric(vertical: 16),
                        side: const BorderSide(color: AdnColors.border),
                      ),
                      child: const Text('Cancelar'),
                    ),
                  ),

                  const SizedBox(width: 12),

                  Expanded(
                    child: FilledButton(
                      key: const Key('payment_validate'),
                      onPressed: _validateDraft,
                      style: FilledButton.styleFrom(
                        backgroundColor: AdnColors.turquoise,
                        foregroundColor: Colors.white,
                        padding: const EdgeInsets.symmetric(vertical: 16),
                      ),
                      child: const Text(
                        'Validar borrador',
                        style: TextStyle(fontWeight: FontWeight.w800),
                      ),
                    ),
                  ),
                ],
              ),
            ],
          ),
        ),
      ),
    );
  }
}
