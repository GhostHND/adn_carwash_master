// ============================================================
// ADN CARWASH MASTER
// MODULO DE PAGOS
// ============================================================

class PaymentsScreen extends StatelessWidget {
  const PaymentsScreen({super.key});

  Future<void> _openPaymentForm(BuildContext context) async {
    final validated = await showDialog<bool>(
      context: context,
      builder: (_) => const PaymentFormDialog(),
    );

    if (!context.mounted || validated != true) {
      return;
    }

    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text(
          'Borrador validado. No se registr\u00f3 '
          'ning\u00fan pago ni se emiti\u00f3 un comprobante. '
          'Primero necesitamos una suscripci\u00f3n '
          'real y la conexi\u00f3n con el servidor.',
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (context, constraints) {
        final mobile = constraints.maxWidth < 620;
        final padding = mobile ? 18.0 : 29.0;
        final available = constraints.maxWidth - padding * 2;

        final columns = available >= 1080
            ? 4
            : available >= 560
            ? 2
            : 1;

        final cardWidth = (available - 14 * (columns - 1)) / columns;

        return SingleChildScrollView(
          padding: EdgeInsets.all(padding),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              if (mobile)
                Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    const _PaymentsHeading(),
                    const SizedBox(height: 20),
                    SizedBox(
                      width: double.infinity,
                      child: _NewPaymentButton(
                        onPressed: () => _openPaymentForm(context),
                      ),
                    ),
                  ],
                )
              else
                Row(
                  children: [
                    const Expanded(child: _PaymentsHeading()),
                    const SizedBox(width: 16),
                    _NewPaymentButton(
                      onPressed: () => _openPaymentForm(context),
                    ),
                  ],
                ),

              const SizedBox(height: 25),

              Wrap(
                spacing: 14,
                runSpacing: 14,
                children: [
                  _PaymentMetric(
                    width: cardWidth,
                    title: 'Pagos registrados',
                    icon: Icons.receipt_long_rounded,
                    color: AdnColors.turquoise,
                  ),
                  _PaymentMetric(
                    width: cardWidth,
                    title: 'Importe recaudado',
                    icon: Icons.account_balance_wallet_rounded,
                    color: const Color(0xFF22C55E),
                  ),
                  _PaymentMetric(
                    width: cardWidth,
                    title: 'Saldos pendientes',
                    icon: Icons.pending_actions_rounded,
                    color: const Color(0xFFF5C000),
                  ),
                  _PaymentMetric(
                    width: cardWidth,
                    title: 'Comprobantes emitidos',
                    icon: Icons.description_outlined,
                    color: AdnColors.coral,
                  ),
                ],
              ),

              const SizedBox(height: 24),

              const _PaymentNotice(),

              const SizedBox(height: 24),

              const _PaymentsDirectory(),

              const SizedBox(height: 24),

              const _PaymentInformation(),
            ],
          ),
        );
      },
    );
  }
}

