    return LayoutBuilder(
      builder: (context, constraints) {
        final mobile = constraints.maxWidth < 620;
        final padding = mobile ? 18.0 : 29.0;
        final available = constraints.maxWidth - padding * 2;

        final columns = available >= 1080
            ? 4
            : available >= 560
            ? 2
            : 1;

        final cardWidth = (available - 14 * (columns - 1)) / columns;

        return SingleChildScrollView(
          padding: EdgeInsets.all(padding),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              const _PageHeading(),

              const SizedBox(height: 25),

              Wrap(
                spacing: 14,
                runSpacing: 14,
                children: [
                  _StatusMetric(
                    width: cardWidth,
                    title: 'Pendientes de activar',
                    icon: Icons.hourglass_top_rounded,
                    accent: const Color(0xFFF5C000),
                  ),
                  _StatusMetric(
                    width: cardWidth,
                    title: 'Empresas activas',
                    icon: Icons.check_circle_rounded,
                    accent: const Color(0xFF22C55E),
                  ),
                  _StatusMetric(
                    width: cardWidth,
                    title: 'Empresas suspendidas',
                    icon: Icons.pause_circle_rounded,
                    accent: AdnColors.coral,
                  ),
                  _StatusMetric(
                    width: cardWidth,
                    title: 'Empresas archivadas',
                    icon: Icons.archive_rounded,
                    accent: AdnColors.muted,
                  ),
                ],
              ),

              const SizedBox(height: 24),

              const _DevelopmentNotice(),

              const SizedBox(height: 24),

              const _CompanyDirectory(),

              const SizedBox(height: 24),

              const _StatusRules(),

              const SizedBox(height: 24),

              const _AccessNotice(),
