enum CompanyAccessStatus { pending, active, suspended, archived }

enum CompanyStatusAction { activate, suspend, reactivate, archive, restore }

// ============================================================
// REGLAS DE TRANSICION
// ============================================================

class CompanyStatusPolicy {
  const CompanyStatusPolicy._();

  static CompanyAccessStatus? nextStatus({
    required CompanyAccessStatus current,
    required CompanyStatusAction action,
    bool subscriptionEligible = false,
  }) {
    switch (action) {
      case CompanyStatusAction.activate:
        if (current == CompanyAccessStatus.pending && subscriptionEligible) {
          return CompanyAccessStatus.active;
        }
        return null;

      case CompanyStatusAction.suspend:
        if (current == CompanyAccessStatus.active) {
          return CompanyAccessStatus.suspended;
        }
        return null;

      case CompanyStatusAction.reactivate:
        if (current == CompanyAccessStatus.suspended && subscriptionEligible) {
          return CompanyAccessStatus.active;
        }
        return null;

      case CompanyStatusAction.archive:
        if (current != CompanyAccessStatus.archived) {
          return CompanyAccessStatus.archived;
        }
        return null;

      case CompanyStatusAction.restore:
        if (current == CompanyAccessStatus.archived) {
          return CompanyAccessStatus.suspended;
        }
        return null;
    }
  }
}

